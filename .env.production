# Production backend (CMS & API).
#
# Committed on purpose: NEXT_PUBLIC_* values are inlined into the browser bundle
# at build time, so this is public either way — there is no secret here to leak,
# only a URL the browser must already know. Committing it means a fresh Vercel
# build produces a working site even if the dashboard env var is absent.
#
# Vercel dashboard values still WIN over this file, so setting it there (Project
# Settings -> Environment Variables) remains the way to repoint the site without
# a code change.
NEXT_PUBLIC_API_BASE_URL=https://country-kids-backend-chi.vercel.app/api/v1
